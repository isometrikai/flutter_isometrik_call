# Copy this file to `.env` in the same directory (`example/.env`) and fill in real values.
# `.env` is gitignored — safe for local secrets. Do not commit `.env`.

# Required — Isometrik project / auth (see demo_config.dart for where each is used).
ISOMETRIK_ACCOUNT_ID=
ISOMETRIK_PROJECT_ID=
ISOMETRIK_KEYSET_ID=
ISOMETRIK_LICENSE_KEY=
ISOMETRIK_APP_SECRET=
ISOMETRIK_USER_SECRET=

# Optional — defaults match public Isometrik endpoints if omitted.
# ISOMETRIK_API_BASE_URL=https://apis.isometrik.io
# ISOMETRIK_MQTT_HOST=connections.isometrik.io
# ISOMETRIK_MQTT_PORT=2052
# ISOMETRIK_STREAMING_URL=wss://streaming.isometrik.io

# When true, HTTP debug logs include secrets and tokens. Use false for shared builds.
DEMO_HTTP_LOG_FULL_SECRETS=false
